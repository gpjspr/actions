# Copy this file to `.env` and fill in real values for local runs.
# In CI these values come from GitHub Secrets / Variables (see workflow).

# Full "play" URL of the published WelcomeBOT canvas app for the target environment, e.g.
# https://apps.powerapps.com/play/e/<environmentId>/a/<appId>?tenantId=<tenantId>
WELCOMEBOT_APP_URL=

# Non-MFA test user credentials (Entra ID / Microsoft 365 account).
# IMPORTANT: The account MUST have MFA disabled/excluded, otherwise automated login cannot complete.
WELCOMEBOT_TEST_USER=
WELCOMEBOT_TEST_PASSWORD=
